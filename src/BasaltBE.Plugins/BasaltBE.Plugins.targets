<Project>
  <Target Name="CopyBasaltHostReferences" AfterTargets="Publish">
    <ItemGroup>
      <BasaltHostReference Include="$(MSBuildThisFileDirectory)../ref/net10.0/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BasaltHostReference)" DestinationFolder="$(PublishDir).basalt/references/" />
    <PropertyGroup>
      <BasaltHostJson>[@(BasaltHostReference->'&quot;%(Filename)%(Extension)&quot;', ',')]</BasaltHostJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(PublishDir)host.json"
                      Lines="$(BasaltHostJson)"
                      Overwrite="true" />
  </Target>
</Project>
