<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="../BasaltBE.Plugins/BasaltBE.Plugins.csproj" />
    <ProjectReference Include="..\BasaltBE.Basalt\BasaltBE.Basalt.csproj" />
    <ProjectReference Include="..\BasaltBE.NetherNet\BasaltBE.NetherNet.csproj" />
    <ProjectReference Include="..\BasaltBE.Protocol\BasaltBE.Protocol.csproj" />
    <ProjectReference Include="..\BasaltBE.Logger\BasaltBE.Logger.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>BasaltBE.DedicatedServer</RootNamespace>
    <AssemblyName>DedicatedServer</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

</Project>
