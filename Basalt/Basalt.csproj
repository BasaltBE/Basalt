<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_")).Core</RootNamespace>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BedrockProtocol\src\Basalt.BedrockProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Basalt.Binary" Version="0.1.0" />
    <PackageReference Include="Tmds.LibC" Version="0.2.0" />
    <PackageReference Include="conmaster.compression.spanzlib" Version="1.1.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="LevelDB.Net.MCPE" Version="1.1.7" />
    <PackageReference Include="LevelDB.Net.Platform" Version="1.1.7" />
    <PackageReference Include="Tracy-CSharp" Version="0.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Nethernet\**\*.cs" Link="Nethernet\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)tmds.libc\0.2.0\ref\netstandard2.0\Tmds.LibC.dll" Link="Tmds.LibC.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(NuGetPackageRoot)tmds.libc\0.2.0\ref\netstandard2.0\Tmds.LibC.dll')" />
    <Reference Include="Tmds.LibC">
      <HintPath>$(NuGetPackageRoot)tmds.libc\0.2.0\ref\netstandard2.0\Tmds.LibC.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Protocol\Data\**\*.json">
      <Link>Protocol\Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <LogicalName>Protocol.Data.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
